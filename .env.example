# Local Docker Compose defaults. Generate the two secrets before starting.
# Use URL-safe values for POSTGRES_PASSWORD (it is part of DATABASE_URL).
POSTGRES_DB=medguides
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
TZ=Europe/Moscow

# Required by upload/delete/enrich/metrics. Empty means admin APIs return 503.
ADMIN_API_TOKEN=
# Optional override; the UI otherwise uses ADMIN_API_TOKEN.
# UI_ADMIN_API_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:7860,http://127.0.0.1:7860,http://localhost:8080,http://127.0.0.1:8080
UPLOAD_MAX_BYTES=26214400
DATA_RAW_DIR=/app/data/raw

# Required for embeddings, even when another LLM provider generates answers.
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
# Optional IAM credentials for the embedding/translation clients.
YANDEX_IAM_TOKEN=
YANDEX_EMBEDDINGS_URL=https://ai.api.cloud.yandex.net/foundationModels/v1/textEmbedding
# Model URIs are derived from YANDEX_FOLDER_ID in code. Override only if needed:
# YANDEX_EMBEDDING_MODEL_URI=emb://your-folder-id/text-search-doc/latest
# YANDEX_EMBEDDING_QUERY_MODEL_URI=emb://your-folder-id/text-search-query/latest
EMBEDDING_DIM=256

# Text generation: yandex | openai | anthropic
LLM_PROVIDER=yandex
LLM_MODEL_FAMILY=yandexgpt
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
YC_OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Preserve the original bilingual retrieval defaults (Yandex translation API).
YANDEX_TRANSLATE_URL=https://translate.api.cloud.yandex.net/translate/v2/translate
RETRIEVER_TRANSLATE_MODE=dual_query
RETRIEVER_TRANSLATE_QUERY_TARGET_LANG=en
RETRIEVER_TRANSLATE_TARGET_LANG=ru
RETRIEVER_TRANSLATE_SOURCE_LANG=
YANDEX_CREDENTIAL_PROFILE=default
PERSONAL_YANDEX_FOLDER_ID=
PERSONAL_YANDEX_API_KEY=
PERSONAL_YANDEX_IAM_TOKEN=

RETRIEVER_MODE=hybrid
RETRIEVER_QUERY_DECOMPOSITION=1
ANSWER_MODEL_FAMILY=alice
ANSWER_TOP_K=6
ANSWER_TRANSLATE_MODE=dual_query
ANSWER_TEMPERATURE=0.2
ANSWER_MAX_OUTPUT_TOKENS=1800

# Optional full Compose HTTPS deployment
DOMAIN=example.org
